TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME="tg_kite_bot"

KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_REDIRECT_URL=https://kite.trade

# 32-byte key for encrypting Kite tokens at rest (openssl rand -base64 32)
SESSION_ENCRYPTION_KEY=

DB_FILE=kite_bot.db

# AI Analysis (optional - for /analyze command)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
# Optional: use for faster guild-scoped slash command registration during development
DISCORD_GUILD_ID=your_discord_guild_id
